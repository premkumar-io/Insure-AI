# InsureAI Environment Configuration Example
# Copy this file to .env for local overrides

# Backend API URL used by the Streamlit frontend
API_URL=http://localhost:8000/predict

# FastAPI Server Port
PORT=8000

# CORS Allowed Origins (Comma separated or * for dev)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Environment mode (development / staging / production)
ENVIRONMENT=development
